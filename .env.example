# Neural Capital AI Agent Configuration - Template
# Copy this to .env and fill in your actual API keys

# =============================================================================
# CORE API KEYS
# =============================================================================
AI_ML_API_KEY=your_ai_ml_key_here
FRED_API_KEY=your_fred_key_here
POLYGON_API_KEY=your_polygon_key_here

# AI Services
OPENROUTER_API_KEY=your_openrouter_key_here
MISTRAL_API_KEY=your_mistral_key_here

# =============================================================================
# CORAL PROTOCOL CONFIGURATION
# =============================================================================
CORAL_PROTOCOL_ENABLED=true
CORAL_SERVER_URL=http://localhost:5555
CORAL_API_BASE_URL=http://localhost:8000
CORAL_MARKETPLACE_API_URL=https://api.coralprotocol.org
CROSSMINT_API_KEY=your_crossmint_key_here

# =============================================================================
# AGENT CONFIGURATION
# =============================================================================
# Data Agent Settings
DATA_REFRESH_INTERVAL=5
CACHE_DURATION=15
MAX_HISTORICAL_DAYS=365
ENABLE_REAL_TIME=true

# Portfolio Agent Settings
RISK_TOLERANCE=moderate
ENABLE_STRESS_TESTING=true
VAR_CONFIDENCE_LEVEL=0.95
OPTIMIZATION_METHOD=mean_variance

# Explainability Agent Settings
EXPLANATION_DEPTH=detailed
TECHNICAL_LEVEL=intermediate
INCLUDE_CHARTS=true
ENABLE_RISK_WARNINGS=true

# Planning Agent Settings
PLANNING_HORIZON=10
ENABLE_MONTE_CARLO=true
SIMULATION_ITERATIONS=1000
GOAL_PRIORITIZATION=true

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================
URL_SUPABASE=https://your-project.supabase.co
KEY_SUPABASE=your_supabase_key_here

# =============================================================================
# TRADING CONFIGURATION
# =============================================================================
API_KEY_ALPACA=your_alpaca_key_here
API_SECRET_ALPACA=your_alpaca_secret_here
URL_ALPACA=paper-api.alpaca.markets

# =============================================================================
# DEVELOPMENT SETTINGS
# =============================================================================
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO