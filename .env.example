# Neural Capital AI Agent Configuration
# Copy this file to .env and fill in your actual values

# API Keys
AI_ML_API_KEY=your_mistral_api_key_here
POLYGON_API_KEY=your_polygon_api_key_here
FRED_KEY=your_fred_api_key_here

# Supabase Configuration
URL_SUPABASE=your_supabase_url_here
KEY_SUPABASE=your_supabase_key_here

# Alpaca Trading Configuration
API_KEY_ALPACA=your_alpaca_api_key_here
API_SECRET_ALPACA=your_alpaca_secret_here
URL_ALPACA=https://paper-api.alpaca.markets

# FRED API Configuration
URL_FRED=https://api.stlouisfed.org/fred

# Coral Protocol Configuration
CORAL_SERVER_URL=http://localhost:5555
CORAL_API_BASE_URL=http://localhost:8000

# Development Settings
ENVIRONMENT=development
DEBUG=true