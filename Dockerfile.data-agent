# Neural Capital Data Agent - Coral Protocol Compatible
FROM python:3.11-slim

LABEL maintainer="Neural Capital <hello@neural-capital.com>"
LABEL description="Neural Capital Data Agent for Coral Protocol"
LABEL version="1.0.0"

WORKDIR /app

# Install system dependencies
RUN apt-get update && apt-get install -y \
    gcc \
    && rm -rf /var/lib/apt/lists/*

# Copy requirements and install Python dependencies
COPY requirements.txt ./
RUN pip install --no-cache-dir -r requirements.txt

# Copy application code
COPY . .

# Create non-root user for security
RUN useradd --create-home --shell /bin/bash agent
RUN chown -R agent:agent /app
USER agent

# Environment variables for Coral Protocol
ENV PYTHONPATH=/app
ENV AGENT_TYPE=data_agent
ENV CORAL_PROTOCOL_ENABLED=true

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD python -c "import requests; requests.get('http://localhost:8000/health')" || exit 1

# Expose port
EXPOSE 8000

# Start the data agent
CMD ["python", "-m", "agent.core.data_agent"]